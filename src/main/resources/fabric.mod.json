{
  "schemaVersion": 1,
  "id": "ae2wtlib",
  "version": "${version}",
  "name": "AE2WTLib",
  "description": "Adds Wireless versions of ae2 Terminals with infinite range capabilities. Unofficial Fabric port of the NeoForge 26.1 version, for Applied Energistics 2: Fabricated.",
  "authors": ["mari_023", "Ridanisaurus"],
  "contributors": ["alec-scott (Fabric 26.1.2 port)"],
  "contact": {
    "homepage": "https://modrinth.com/mod/applied-energistics-2-wireless-terminals",
    "sources": "https://github.com/alec-scott/AE2WirelessTerminalLibrary",
    "issues": "https://github.com/alec-scott/AE2WirelessTerminalLibrary/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "jei_mod_plugin": ["de.mari_023.ae2wtlib.recipeviewer.JEIPlugin"],
    "rei_client": ["de.mari_023.ae2wtlib.recipeviewer.REIPlugin"],
    "emi": ["de.mari_023.ae2wtlib.recipeviewer.AE2wtlibEmiPlugin"],
    "modmenu": ["de.mari_023.ae2wtlib.ModMenuIntegration"]
  },
  "mixins": ["ae2wtlib.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "ae2": ">=${ae2_version}",
    "ae2wtlib_api": "${version}"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
